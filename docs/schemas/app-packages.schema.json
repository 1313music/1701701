{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://1701701.xyz/schemas/app-packages.schema.json",
  "title": "App Packages Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "packages"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "baseUrl": {
      "type": "string",
      "minLength": 1
    },
    "packages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/package"
      }
    }
  },
  "$defs": {
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "filename"
      ],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string"
        },
        "detail": {
          "type": "string"
        },
        "filename": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string"
        },
        "icon": {
          "type": "string"
        },
        "sortOrder": {
          "type": "integer"
        },
        "enabled": {
          "type": "boolean"
        }
      }
    }
  }
}
